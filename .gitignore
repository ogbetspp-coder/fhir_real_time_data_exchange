node_modules/
dist/
coverage/
# The coverage scoreboard's committed summaries (docs/validation/coverage-scoreboard.md): only
# their .json, so nothing else written beside them is ever committed.
!docs/validation/coverage/
docs/validation/coverage/*
!docs/validation/coverage/*.json
.coverage
.env
.env.*
!.env.example
gha-creds-*.json
# The deploy workflow's own log (.github/workflows/deploy.yml). Ignored so it is not uploaded with
# the image build's source, and so the deploy's provenance check does not read it as an
# uncommitted change (scripts/gcp/deploy.sh, deploy_provenance).
deploy-run.log
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.DS_Store
.idea/
.vscode/
.cache/
__pycache__/
*.pyc
fhir/vendor/

# Agent worktrees (Claude Code); each is its own checkout, never committed from here.
.claude/worktrees/
# Per-user Claude Code settings; the shared ones are .claude/settings.json.
.claude/settings.local.json

# The full differential corpus CI writes at the root (the committed smoke corpus lives in
# zone-a/tests/fixtures/), and the nightly parity sweep's digests.
differential.jsonl
parity-sweep.txt

# The owner's local copy of the EMA's IG downloads (hundreds of MB); each file is pinned by URL
# and hash in fhir/standards.lock.json instead.
/context*/
