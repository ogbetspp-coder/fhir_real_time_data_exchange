{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khs.dev/contracts/run-manifest/3.0.0/schema.json",
  "$ref": "#/$defs/RunManifest",
  "$defs": {
    "RunManifest": {
      "oneOf": [
        {
          "$ref": "#/$defs/ValidatedRunManifest"
        },
        {
          "$ref": "#/$defs/AuthorisedRunManifest"
        }
      ]
    },
    "ValidatedRunManifest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "3.0.0"
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["fixture", "healthcare-api", "document"]
            },
            "resource": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "hash": {
              "$ref": "#/$defs/Sha256Hex"
            }
          },
          "required": ["kind", "resource", "hash"],
          "additionalProperties": false
        },
        "runId": {
          "$ref": "#/$defs/Uuid"
        },
        "startedAt": {
          "$ref": "#/$defs/IsoDateTime"
        },
        "completedAt": {
          "$ref": "#/$defs/IsoDateTime"
        },
        "standards": {
          "$ref": "#/$defs/ManifestStandards"
        },
        "validation": {
          "$ref": "#/$defs/ManifestValidation"
        },
        "transformation": {
          "$ref": "#/$defs/ManifestTransformation"
        },
        "runtime": {
          "$ref": "#/$defs/ManifestRuntime"
        },
        "ingestion": {
          "$ref": "#/$defs/IngestionEvidence"
        },
        "status": {
          "type": "string",
          "const": "validated"
        },
        "dryRun": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "schemaVersion",
        "source",
        "runId",
        "startedAt",
        "completedAt",
        "standards",
        "validation",
        "transformation",
        "runtime",
        "status",
        "dryRun"
      ],
      "additionalProperties": false
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lower-case hexadecimal SHA-256 digest."
    },
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "IsoDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with Z or a numeric offset."
    },
    "ManifestStandards": {
      "type": "object",
      "properties": {
        "fhir": {
          "type": "string",
          "const": "5.0.0"
        },
        "globalEpiPackage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "emaPackage": {
          "type": "string",
          "const": "EUePI#1.0.0"
        },
        "qrdTemplate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "mappingVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": ["fhir", "globalEpiPackage", "emaPackage", "qrdTemplate", "mappingVersion"],
      "additionalProperties": false
    },
    "ManifestValidation": {
      "type": "object",
      "properties": {
        "preflightErrors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "officialValidationExecuted": {
          "type": "boolean"
        },
        "officialProfileErrors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cloudValidationExecuted": {
          "type": "boolean"
        },
        "cloudProfileErrors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HttpUrl"
          }
        }
      },
      "required": [
        "preflightErrors",
        "officialValidationExecuted",
        "officialProfileErrors",
        "cloudValidationExecuted",
        "cloudProfileErrors",
        "profiles"
      ],
      "additionalProperties": false
    },
    "HttpUrl": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^https?:\\/\\/[A-Za-z0-9.-]{1,253}(?::\\d{1,5})?(?:[/?#][A-Za-z0-9._~:/?#@!$&'()*+,;=%|-]*)?$",
      "description": "http(s) URL without whitespace; may carry |version."
    },
    "ManifestTransformation": {
      "type": "object",
      "properties": {
        "inputHash": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "outputHash": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "decisions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["inputHash", "outputHash", "decisions"],
      "additionalProperties": false
    },
    "ManifestRuntime": {
      "type": "object",
      "properties": {
        "sourceCommit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "imageDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "workflowRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": ["sourceCommit", "imageDigest", "workflowRevision"],
      "additionalProperties": false
    },
    "IngestionEvidence": {
      "type": "object",
      "properties": {
        "submissionId": {
          "$ref": "#/$defs/Uuid"
        },
        "contractVersion": {
          "type": "string",
          "const": "2.0.0"
        },
        "sourceKind": {
          "type": "string",
          "enum": ["drawn", "authority-publication"]
        },
        "graphType": {
          "$ref": "#/$defs/GraphType"
        },
        "allowSyntheticSources": {
          "type": "boolean"
        },
        "sourceDocumentSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "extractionRunId": {
          "$ref": "#/$defs/Uuid"
        },
        "parser": {
          "$ref": "#/$defs/Token"
        },
        "modelId": {
          "$ref": "#/$defs/Token"
        },
        "promptTemplateVersion": {
          "$ref": "#/$defs/Token"
        },
        "fidelity": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["passed"]
            },
            "normalizationVersion": {
              "$ref": "#/$defs/NormalizationVersion"
            },
            "sectionsChecked": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sectionsMatched": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reportSha256": {
              "$ref": "#/$defs/Sha256Hex"
            },
            "narrativeBindingSha256": {
              "$ref": "#/$defs/Sha256Hex"
            },
            "coverage": {
              "type": "object",
              "properties": {
                "pageCodePoints": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "bodyCodePoints": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "coveredCodePoints": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "uncoveredGaps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "pageCodePoints",
                "bodyCodePoints",
                "coveredCodePoints",
                "uncoveredGaps"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "normalizationVersion",
            "sectionsChecked",
            "sectionsMatched",
            "reportSha256",
            "narrativeBindingSha256",
            "coverage"
          ],
          "additionalProperties": false
        },
        "approval": {
          "$ref": "#/$defs/Approval"
        },
        "authority": {
          "$ref": "#/$defs/AuthorityFetch"
        },
        "provenanceResourceId": {
          "$ref": "#/$defs/Uuid"
        }
      },
      "required": [
        "submissionId",
        "contractVersion",
        "sourceKind",
        "graphType",
        "allowSyntheticSources",
        "sourceDocumentSha256",
        "extractionRunId",
        "parser",
        "fidelity",
        "approval",
        "provenanceResourceId"
      ],
      "additionalProperties": false,
      "description": "Hashes, counts, enumerations, and identifiers only; never narrative."
    },
    "GraphType": {
      "type": "string",
      "enum": ["type1", "type2"]
    },
    "Token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,127}$",
      "description": "Identifier: letters, digits, and . _ : / @ + - only."
    },
    "NormalizationVersion": {
      "type": "string",
      "pattern": "^fidelity-norm\\/\\d+\\.\\d+\\.\\d+$",
      "description": "Version of docs/fidelity-normalization.md the hashes were computed under."
    },
    "Approval": {
      "oneOf": [
        {
          "$ref": "#/$defs/AttestedApproval"
        },
        {
          "$ref": "#/$defs/AuthorityApproval"
        }
      ]
    },
    "AttestedApproval": {
      "type": "object",
      "properties": {
        "approverId": {
          "$ref": "#/$defs/PrincipalId"
        },
        "approverRole": {
          "$ref": "#/$defs/ApproverRole"
        },
        "approvedAt": {
          "$ref": "#/$defs/IsoDateTime"
        },
        "method": {
          "$ref": "#/$defs/AttestationMethod"
        },
        "meaning": {
          "$ref": "#/$defs/ApprovalMeaning"
        },
        "approvedContentSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "recordRef": {
          "$ref": "#/$defs/RecordRef"
        }
      },
      "required": [
        "approverId",
        "approverRole",
        "approvedAt",
        "method",
        "meaning",
        "approvedContentSha256"
      ],
      "additionalProperties": false
    },
    "PrincipalId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "ApproverRole": {
      "type": "string",
      "enum": ["content-reviewer", "qa-reviewer"]
    },
    "AttestationMethod": {
      "type": "string",
      "enum": ["api-attestation", "manual-record"],
      "description": "Attestation placeholders. Electronic signature is a future control boundary."
    },
    "ApprovalMeaning": {
      "type": "string",
      "enum": ["reviewed-fidelity-and-structure"]
    },
    "RecordRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#?=&%+-]{0,511}$"
    },
    "AuthorityApproval": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "authority-publication"
        },
        "meaning": {
          "type": "string",
          "const": "authority-publication-imported"
        },
        "authority": {
          "$ref": "#/$defs/Authority"
        },
        "authorityStatus": {
          "$ref": "#/$defs/AuthorityStatus"
        },
        "publication": {
          "type": "object",
          "properties": {
            "epiId": {
              "$ref": "#/$defs/Token"
            },
            "documentId": {
              "$ref": "#/$defs/AuthorityId"
            },
            "indexId": {
              "$ref": "#/$defs/AuthorityId"
            },
            "versionNumber": {
              "$ref": "#/$defs/Token"
            },
            "procedureNumber": {
              "$ref": "#/$defs/Token"
            },
            "authorityTimestamp": {
              "$ref": "#/$defs/IsoDateTime"
            }
          },
          "required": [
            "epiId",
            "documentId",
            "indexId",
            "versionNumber",
            "procedureNumber",
            "authorityTimestamp"
          ],
          "additionalProperties": false
        },
        "requestedBy": {
          "$ref": "#/$defs/PrincipalId"
        },
        "requestedAt": {
          "$ref": "#/$defs/IsoDateTime"
        },
        "approvedContentSha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": [
        "method",
        "meaning",
        "authority",
        "authorityStatus",
        "publication",
        "requestedBy",
        "requestedAt",
        "approvedContentSha256"
      ],
      "additionalProperties": false,
      "description": "The approval is the authority's publication; the person named requested the import (docs/design/authority-import-contract.md, D2, D8)."
    },
    "Authority": {
      "type": "string",
      "enum": ["EMA", "synthetic"]
    },
    "AuthorityStatus": {
      "type": "string",
      "enum": ["pilot"]
    },
    "AuthorityId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
      "description": "A lower-case GUID."
    },
    "AuthorityFetch": {
      "type": "object",
      "properties": {
        "importerVersion": {
          "$ref": "#/$defs/Token"
        },
        "fetched": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "$ref": "#/$defs/HttpUrl"
              },
              "sha256": {
                "$ref": "#/$defs/Sha256Hex"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "fetchedAt": {
                "$ref": "#/$defs/IsoDateTime"
              },
              "evidenceUri": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": ["url", "sha256", "byteLength", "fetchedAt"],
            "additionalProperties": false
          }
        }
      },
      "required": ["importerVersion", "fetched"],
      "additionalProperties": false
    },
    "AuthorisedRunManifest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "3.0.0"
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["fixture", "healthcare-api", "document"]
            },
            "resource": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "hash": {
              "$ref": "#/$defs/Sha256Hex"
            }
          },
          "required": ["kind", "resource", "hash"],
          "additionalProperties": false
        },
        "runId": {
          "$ref": "#/$defs/Uuid"
        },
        "startedAt": {
          "$ref": "#/$defs/IsoDateTime"
        },
        "completedAt": {
          "$ref": "#/$defs/IsoDateTime"
        },
        "standards": {
          "$ref": "#/$defs/ManifestStandards"
        },
        "validation": {
          "$ref": "#/$defs/ManifestValidation"
        },
        "transformation": {
          "$ref": "#/$defs/ManifestTransformation"
        },
        "runtime": {
          "$ref": "#/$defs/ManifestRuntime"
        },
        "ingestion": {
          "$ref": "#/$defs/IngestionEvidence"
        },
        "status": {
          "type": "string",
          "const": "authorised"
        },
        "dryRun": {
          "type": "boolean",
          "const": false
        },
        "persistence": {
          "$ref": "#/$defs/ManifestPersistence"
        }
      },
      "required": [
        "schemaVersion",
        "source",
        "runId",
        "startedAt",
        "completedAt",
        "standards",
        "validation",
        "transformation",
        "runtime",
        "status",
        "dryRun",
        "persistence"
      ],
      "additionalProperties": false
    },
    "ManifestPersistence": {
      "type": "object",
      "properties": {
        "targetStore": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "transactionSha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": ["targetStore", "transactionSha256"],
      "additionalProperties": false
    }
  }
}
