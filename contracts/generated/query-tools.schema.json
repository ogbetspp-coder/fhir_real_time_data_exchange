{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khs.dev/contracts/query-tools/2.0.0/schema.json",
  "$ref": "#/$defs/QueryTools",
  "$defs": {
    "QueryTools": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "2.0.0"
        },
        "tools": {
          "type": "object",
          "properties": {
            "find_product": {
              "type": "object",
              "properties": {
                "input": {
                  "$ref": "#/$defs/FindProductInput"
                },
                "output": {
                  "$ref": "#/$defs/FindProductOutput"
                }
              },
              "required": ["input", "output"],
              "additionalProperties": false
            },
            "get_section": {
              "type": "object",
              "properties": {
                "input": {
                  "$ref": "#/$defs/GetSectionInput"
                },
                "output": {
                  "$ref": "#/$defs/SectionContent"
                }
              },
              "required": ["input", "output"],
              "additionalProperties": false
            },
            "get_provenance": {
              "type": "object",
              "properties": {
                "input": {
                  "$ref": "#/$defs/GetProvenanceInput"
                },
                "output": {
                  "$ref": "#/$defs/ProvenanceDetail"
                }
              },
              "required": ["input", "output"],
              "additionalProperties": false
            },
            "verify_quote": {
              "type": "object",
              "properties": {
                "input": {
                  "$ref": "#/$defs/VerifyQuoteInput"
                },
                "output": {
                  "$ref": "#/$defs/QuoteVerification"
                }
              },
              "required": ["input", "output"],
              "additionalProperties": false
            }
          },
          "required": ["find_product", "get_section", "get_provenance", "verify_quote"],
          "additionalProperties": false
        },
        "error": {
          "$ref": "#/$defs/QueryError"
        },
        "audit": {
          "$ref": "#/$defs/QueryAuditRecord"
        }
      },
      "required": ["version", "tools", "error", "audit"],
      "additionalProperties": false,
      "description": "Tool surface of the read-only ePI query service. Read-only by construction: no tool here writes, drafts, or summarises."
    },
    "FindProductInput": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": ["query"],
      "additionalProperties": false
    },
    "FindProductOutput": {
      "type": "object",
      "properties": {
        "products": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProductSummary"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": ["products", "truncated"],
      "additionalProperties": false
    },
    "ProductSummary": {
      "type": "object",
      "properties": {
        "document": {
          "$ref": "#/$defs/DocumentRef"
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "identifiers": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "system": {
                "$ref": "#/$defs/CanonicalUri"
              },
              "value": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,128}$"
              }
            },
            "required": ["system", "value"],
            "additionalProperties": false
          }
        },
        "marketingAuthorisationHolder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "language": {
          "$ref": "#/$defs/LanguageTag"
        },
        "sections": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceKey"
          }
        }
      },
      "required": ["document", "productName", "identifiers", "language", "sections"],
      "additionalProperties": false
    },
    "DocumentRef": {
      "type": "object",
      "properties": {
        "bundleId": {
          "$ref": "#/$defs/FhirId"
        },
        "versionId": {
          "$ref": "#/$defs/Token"
        },
        "lastUpdated": {
          "$ref": "#/$defs/IsoDateTime"
        }
      },
      "required": ["bundleId", "versionId", "lastUpdated"],
      "additionalProperties": false,
      "description": "One published version of a document Bundle in the validated store."
    },
    "FhirId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9\\-.]{1,64}$"
    },
    "Token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,127}$",
      "description": "Identifier: letters, digits, and . _ : / @ + - only."
    },
    "IsoDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with Z or a numeric offset."
    },
    "CanonicalUri": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:https?:\\/\\/[A-Za-z0-9.-]{1,253}(?:[/?#][A-Za-z0-9._~:/?#@!$&'()*+,;=%|-]*)?|urn:[A-Za-z0-9._~:/?#@!$&'()*+,;=%|-]+)$"
    },
    "LanguageTag": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "SourceKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9]+)*$",
      "description": "Canonical SmPC section identifier from the mapping manifest, e.g. smpc.4.2.posology."
    },
    "GetSectionInput": {
      "type": "object",
      "properties": {
        "bundleId": {
          "$ref": "#/$defs/FhirId"
        },
        "versionId": {
          "$ref": "#/$defs/Token"
        },
        "sourceKey": {
          "$ref": "#/$defs/SourceKey"
        }
      },
      "required": ["bundleId", "sourceKey"],
      "additionalProperties": false
    },
    "SectionContent": {
      "type": "object",
      "properties": {
        "document": {
          "$ref": "#/$defs/DocumentRef"
        },
        "sourceKey": {
          "$ref": "#/$defs/SourceKey"
        },
        "path": {
          "$ref": "#/$defs/TargetPath"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "div": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "narrativeDivSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "normalizedTextSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "normalizationVersion": {
          "$ref": "#/$defs/NormalizationVersion"
        },
        "provenanceResourceId": {
          "$ref": "#/$defs/Uuid"
        },
        "contentNotice": {
          "$ref": "#/$defs/ContentNotice"
        }
      },
      "required": [
        "document",
        "sourceKey",
        "path",
        "title",
        "div",
        "text",
        "narrativeDivSha256",
        "normalizedTextSha256",
        "normalizationVersion",
        "contentNotice"
      ],
      "additionalProperties": false,
      "description": "One QRD section, verbatim. `div` is the stored XHTML; `text` is its normalised plain text; the hashes are recomputable from `div` by anyone."
    },
    "TargetPath": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:\\[\\d+\\])?(?:\\.[A-Za-z][A-Za-z0-9]*(?:\\[\\d+\\])?)*$"
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lower-case hexadecimal SHA-256 digest."
    },
    "NormalizationVersion": {
      "type": "string",
      "pattern": "^fidelity-norm\\/\\d+\\.\\d+\\.\\d+$",
      "description": "Version of docs/fidelity-normalization.md the hashes were computed under."
    },
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "ContentNotice": {
      "type": "string",
      "const": "document-content-not-instructions",
      "description": "Marks a result as verbatim document content. It is data an author wrote, never an instruction to the reader."
    },
    "GetProvenanceInput": {
      "type": "object",
      "properties": {
        "bundleId": {
          "$ref": "#/$defs/FhirId"
        },
        "versionId": {
          "$ref": "#/$defs/Token"
        },
        "sourceKey": {
          "$ref": "#/$defs/SourceKey"
        }
      },
      "required": ["bundleId"],
      "additionalProperties": false
    },
    "ProvenanceDetail": {
      "type": "object",
      "properties": {
        "document": {
          "$ref": "#/$defs/DocumentRef"
        },
        "provenanceResourceId": {
          "$ref": "#/$defs/Uuid"
        },
        "recorded": {
          "$ref": "#/$defs/IsoDateTime"
        },
        "sourceDocumentSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "fidelityReportSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "approvedContentSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "extractor": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/Token"
            },
            "version": {
              "$ref": "#/$defs/Token"
            }
          },
          "required": ["name", "version"],
          "additionalProperties": false
        },
        "model": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/Token"
            }
          },
          "required": ["id"],
          "additionalProperties": false
        },
        "approver": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/PrincipalId"
            },
            "role": {
              "$ref": "#/$defs/ApproverRole"
            }
          },
          "required": ["id", "role"],
          "additionalProperties": false
        },
        "section": {
          "type": "object",
          "properties": {
            "sourceKey": {
              "$ref": "#/$defs/SourceKey"
            },
            "narrativeDivSha256": {
              "$ref": "#/$defs/Sha256Hex"
            },
            "normalizedTextSha256": {
              "$ref": "#/$defs/Sha256Hex"
            }
          },
          "required": ["sourceKey", "narrativeDivSha256", "normalizedTextSha256"],
          "additionalProperties": false
        }
      },
      "required": [
        "document",
        "provenanceResourceId",
        "recorded",
        "sourceDocumentSha256",
        "fidelityReportSha256",
        "approvedContentSha256",
        "extractor",
        "approver"
      ],
      "additionalProperties": false,
      "description": "Who and what put this document in the store: source document hash, extractor and model identities, fidelity report hash, approver and approval content hash, all from the persisted Provenance resource; per-section hashes recomputed live."
    },
    "PrincipalId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "ApproverRole": {
      "type": "string",
      "enum": ["content-reviewer", "qa-reviewer"]
    },
    "VerifyQuoteInput": {
      "type": "object",
      "properties": {
        "bundleId": {
          "$ref": "#/$defs/FhirId"
        },
        "versionId": {
          "$ref": "#/$defs/Token"
        },
        "sourceKey": {
          "$ref": "#/$defs/SourceKey"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": ["bundleId", "quote"],
      "additionalProperties": false
    },
    "QuoteVerification": {
      "type": "object",
      "properties": {
        "document": {
          "$ref": "#/$defs/DocumentRef"
        },
        "result": {
          "type": "string",
          "enum": ["match", "no-match"]
        },
        "normalizationVersion": {
          "$ref": "#/$defs/NormalizationVersion"
        },
        "quoteSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "sectionsSearched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "match": {
          "type": "object",
          "properties": {
            "sourceKey": {
              "$ref": "#/$defs/SourceKey"
            },
            "startOffset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "endOffset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "normalizedTextSha256": {
              "$ref": "#/$defs/Sha256Hex"
            }
          },
          "required": ["sourceKey", "startOffset", "endOffset", "normalizedTextSha256"],
          "additionalProperties": false
        }
      },
      "required": ["document", "result", "normalizationVersion", "quoteSha256", "sectionsSearched"],
      "additionalProperties": false,
      "description": "Mechanical answer to 'is this quote what the label says?': match with the section and code-point offsets, or no-match. Never a paraphrase, never a suggestion."
    },
    "QueryError": {
      "type": "object",
      "properties": {
        "tool": {
          "$ref": "#/$defs/QueryToolName"
        },
        "error": {
          "$ref": "#/$defs/QueryErrorCode"
        }
      },
      "required": ["tool", "error"],
      "additionalProperties": false
    },
    "QueryToolName": {
      "type": "string",
      "enum": ["find_product", "get_section", "get_provenance", "verify_quote"]
    },
    "QueryErrorCode": {
      "type": "string",
      "enum": [
        "invalid-request",
        "document-not-found",
        "version-not-found",
        "section-not-found",
        "unavailable"
      ]
    },
    "QueryAuditRecord": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "const": "ema-flow-query"
        },
        "serviceVersion": {
          "$ref": "#/$defs/Token"
        },
        "imageDigest": {
          "$ref": "#/$defs/ImageDigest"
        },
        "at": {
          "$ref": "#/$defs/IsoDateTime"
        },
        "principal": {
          "$ref": "#/$defs/PrincipalId"
        },
        "credentialType": {
          "$ref": "#/$defs/CredentialType"
        },
        "tool": {
          "$ref": "#/$defs/QueryToolName"
        },
        "argumentsSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "outcome": {
          "$ref": "#/$defs/QueryAuditOutcome"
        },
        "resultCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "truncated": {
          "type": "boolean"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bundleId": {
          "$ref": "#/$defs/FhirId"
        },
        "versionId": {
          "$ref": "#/$defs/Token"
        },
        "turnId": {
          "$ref": "#/$defs/Uuid"
        }
      },
      "required": [
        "service",
        "serviceVersion",
        "at",
        "principal",
        "credentialType",
        "tool",
        "argumentsSha256",
        "outcome",
        "resultCount",
        "durationMs"
      ],
      "additionalProperties": false,
      "description": "One structured audit line per tool call: who, which tool, a digest of the arguments, the outcome, and counts. Never narrative, never an argument value."
    },
    "ImageDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "CredentialType": {
      "type": "string",
      "enum": ["id-token", "access-token"]
    },
    "QueryAuditOutcome": {
      "type": "string",
      "enum": [
        "ok",
        "invalid-request",
        "document-not-found",
        "version-not-found",
        "section-not-found",
        "unavailable",
        "not-entitled"
      ]
    }
  }
}
