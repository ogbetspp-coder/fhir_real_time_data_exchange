{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khs.dev/contracts/source-document-text/1.0.0/schema.json",
  "$ref": "#/$defs/SourceDocumentText",
  "$defs": {
    "SourceDocumentText": {
      "type": "object",
      "properties": {
        "extractorVersion": {
          "$ref": "#/$defs/Token"
        },
        "pages": {
          "minItems": 1,
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "text": {
                "type": "string",
                "maxLength": 500000
              },
              "bodyStart": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "bodyEnd": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["page", "text", "bodyStart", "bodyEnd"],
            "additionalProperties": false
          }
        }
      },
      "required": ["extractorVersion", "pages"],
      "additionalProperties": false
    },
    "Token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,127}$",
      "description": "Identifier: letters, digits, and . _ : / @ + - only."
    }
  }
}
