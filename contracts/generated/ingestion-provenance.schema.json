{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khs.dev/contracts/ingestion-provenance/3.0.0/schema.json",
  "$ref": "#/$defs/IngestionProvenance",
  "$defs": {
    "IngestionProvenance": {
      "type": "object",
      "properties": {
        "sourceDocument": {
          "$ref": "#/$defs/SourceDocument"
        },
        "extraction": {
          "$ref": "#/$defs/ExtractionTooling"
        },
        "sections": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/SectionProvenance"
          }
        },
        "decisions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/StructuringDecision"
          }
        },
        "fidelity": {
          "$ref": "#/$defs/FidelitySummary"
        }
      },
      "required": ["sourceDocument", "extraction", "sections", "decisions", "fidelity"],
      "additionalProperties": false
    },
    "SourceDocument": {
      "oneOf": [
        {
          "$ref": "#/$defs/DrawnSourceDocument"
        },
        {
          "$ref": "#/$defs/AuthoritySourceDocument"
        },
        {
          "$ref": "#/$defs/CertifiedWordSourceDocument"
        }
      ]
    },
    "DrawnSourceDocument": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "drawn"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "byteLength": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "mediaType": {
          "$ref": "#/$defs/MediaType"
        },
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,254}$"
        },
        "pageCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sourceSystem": {
          "$ref": "#/$defs/SourceSystemRef"
        },
        "storageUri": {
          "$ref": "#/$defs/StorageUri"
        },
        "extractedText": {
          "$ref": "#/$defs/ExtractedTextRef"
        }
      },
      "required": ["kind", "sha256", "byteLength", "mediaType", "filename", "extractedText"],
      "additionalProperties": false
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lower-case hexadecimal SHA-256 digest."
    },
    "MediaType": {
      "type": "string",
      "enum": [
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      ]
    },
    "SourceSystemRef": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Token"
        },
        "documentId": {
          "$ref": "#/$defs/Token"
        },
        "versionId": {
          "$ref": "#/$defs/Token"
        }
      },
      "required": ["name", "documentId"],
      "additionalProperties": false,
      "description": "Identity of the document in its system of record."
    },
    "Token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,127}$",
      "description": "Identifier: letters, digits, and . _ : / @ + - only."
    },
    "StorageUri": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^gs:\\/\\/[a-z0-9][a-z0-9._-]{1,220}[a-z0-9]\\/[A-Za-z0-9._/-]{1,256}$",
      "description": "Cloud Storage object URI (gs://bucket/object)."
    },
    "ExtractedTextRef": {
      "type": "object",
      "properties": {
        "uri": {
          "$ref": "#/$defs/StorageUri"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "extractorVersion": {
          "$ref": "#/$defs/Token"
        }
      },
      "required": ["uri", "sha256", "extractorVersion"],
      "additionalProperties": false,
      "description": "Reference to the extractor's page text (a SourceDocumentText object). It contains narrative and is never inlined."
    },
    "AuthoritySourceDocument": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "authority-publication"
        },
        "mediaType": {
          "type": "string",
          "const": "application/fhir+json"
        },
        "authority": {
          "$ref": "#/$defs/Authority"
        },
        "request": {
          "$ref": "#/$defs/ImportRequest"
        },
        "document": {
          "$ref": "#/$defs/PinnedFile"
        },
        "index": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/AuthorityId"
            },
            "sha256": {
              "$ref": "#/$defs/Sha256Hex"
            },
            "byteLength": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "epiId": {
              "$ref": "#/$defs/Token"
            },
            "versionNumber": {
              "$ref": "#/$defs/Token"
            },
            "metaVersionId": {
              "$ref": "#/$defs/Token"
            },
            "status": {
              "type": "string",
              "const": "current"
            }
          },
          "required": [
            "id",
            "sha256",
            "byteLength",
            "epiId",
            "versionNumber",
            "metaVersionId",
            "status"
          ],
          "additionalProperties": false
        },
        "pictures": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Picture"
          }
        },
        "sectionPages": {
          "minItems": 1,
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "path": {
                "$ref": "#/$defs/SectionPath"
              },
              "code": {
                "$ref": "#/$defs/Token"
              }
            },
            "required": ["page", "path", "code"],
            "additionalProperties": false
          }
        },
        "extractedText": {
          "$ref": "#/$defs/ExtractedTextRef"
        }
      },
      "required": [
        "kind",
        "mediaType",
        "authority",
        "request",
        "document",
        "index",
        "pictures",
        "sectionPages",
        "extractedText"
      ],
      "additionalProperties": false,
      "description": "An authority's published ePI, which Zone B fetches itself and re-imports (docs/design/authority-import-contract.md)."
    },
    "Authority": {
      "type": "string",
      "enum": ["EMA", "synthetic"]
    },
    "ImportRequest": {
      "type": "object",
      "properties": {
        "authority": {
          "$ref": "#/$defs/Authority"
        },
        "documentId": {
          "$ref": "#/$defs/AuthorityId"
        },
        "indexId": {
          "$ref": "#/$defs/AuthorityId"
        },
        "language": {
          "type": "string",
          "const": "en"
        }
      },
      "required": ["authority", "documentId", "indexId", "language"],
      "additionalProperties": false,
      "description": "What a person asked to import: an input to the import, part of the approved content."
    },
    "AuthorityId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
      "description": "A lower-case GUID."
    },
    "PinnedFile": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/AuthorityId"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "byteLength": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["id", "sha256", "byteLength"],
      "additionalProperties": false,
      "description": "Bytes as served, after HTTP content decoding."
    },
    "Picture": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fetched"
            },
            "reference": {
              "$ref": "#/$defs/PictureReference"
            },
            "url": {
              "$ref": "#/$defs/HttpUrl"
            },
            "sha256": {
              "$ref": "#/$defs/Sha256Hex"
            },
            "byteLength": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["kind", "reference", "url", "sha256", "byteLength"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "not-drawn"
            },
            "reference": {
              "$ref": "#/$defs/PictureReference"
            },
            "evidence": {
              "$ref": "#/$defs/Token"
            }
          },
          "required": ["kind", "reference", "evidence"],
          "additionalProperties": false
        }
      ]
    },
    "PictureReference": {
      "type": "string",
      "pattern": "^~\\/_entity\\/annotation\\/[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "HttpUrl": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^https?:\\/\\/[A-Za-z0-9.-]{1,253}(?::[0-9]{1,5})?(?:[/?#][A-Za-z0-9._~:/?#@!$&'()*+,;=%|-]*)?$",
      "description": "http(s) URL without whitespace; may carry |version."
    },
    "SectionPath": {
      "type": "string",
      "pattern": "^Composition(?:\\.section\\[[0-9]{1,4}\\]){1,16}$"
    },
    "CertifiedWordSourceDocument": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "certified-word"
        },
        "mediaType": {
          "type": "string",
          "const": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        },
        "document": {
          "type": "object",
          "properties": {
            "sha256": {
              "$ref": "#/$defs/Sha256Hex"
            },
            "byteLength": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "filename": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,254}$"
            },
            "storageUri": {
              "$ref": "#/$defs/StorageUri"
            }
          },
          "required": ["sha256", "byteLength", "filename", "storageUri"],
          "additionalProperties": false
        },
        "recompute": {
          "$ref": "#/$defs/RecomputeRequest"
        },
        "importer": {
          "$ref": "#/$defs/Token"
        },
        "changes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sectionPages": {
          "minItems": 1,
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "key": {
                "$ref": "#/$defs/SourceKey"
              },
              "code": {
                "$ref": "#/$defs/Token"
              }
            },
            "required": ["page", "key", "code"],
            "additionalProperties": false
          }
        },
        "extractedText": {
          "$ref": "#/$defs/ExtractedTextRef"
        }
      },
      "required": [
        "kind",
        "mediaType",
        "document",
        "recompute",
        "importer",
        "changes",
        "sectionPages",
        "extractedText"
      ],
      "additionalProperties": false,
      "description": "A Word label the label reader read exactly, made into sections by Zone A's recompute (ADR 0006, docs/design/certified-word-import.md)."
    },
    "RecomputeRequest": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string",
          "enum": ["smpc", "pl"]
        },
        "view": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["accepted", "original"]
            },
            {
              "type": "null"
            }
          ]
        },
        "part": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "assignments": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/SourceKey"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "versions": {
          "$ref": "#/$defs/RecomputeVersions"
        }
      },
      "required": ["document", "view", "part", "assignments", "versions"],
      "additionalProperties": false
    },
    "SourceKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9]+)*$",
      "description": "Canonical SmPC section identifier from the mapping manifest, e.g. smpc.4.2.posology."
    },
    "RecomputeVersions": {
      "type": "object",
      "properties": {
        "recompute": {
          "$ref": "#/$defs/Token"
        },
        "reader": {
          "$ref": "#/$defs/Token"
        },
        "format": {
          "$ref": "#/$defs/Token"
        },
        "structurer": {
          "$ref": "#/$defs/Token"
        },
        "registryVersion": {
          "$ref": "#/$defs/Token"
        },
        "mappingVersion": {
          "$ref": "#/$defs/Token"
        },
        "builder": {
          "$ref": "#/$defs/Token"
        }
      },
      "required": [
        "recompute",
        "reader",
        "format",
        "structurer",
        "registryVersion",
        "mappingVersion",
        "builder"
      ],
      "additionalProperties": false
    },
    "ExtractionTooling": {
      "type": "object",
      "properties": {
        "extractionRunId": {
          "$ref": "#/$defs/Uuid"
        },
        "serviceVersion": {
          "$ref": "#/$defs/Token"
        },
        "parser": {
          "$ref": "#/$defs/ToolVersion"
        },
        "model": {
          "$ref": "#/$defs/ModelRef"
        },
        "promptTemplate": {
          "$ref": "#/$defs/PromptTemplateRef"
        },
        "terminologyService": {
          "$ref": "#/$defs/TerminologyServiceRef"
        }
      },
      "required": ["extractionRunId", "serviceVersion", "parser"],
      "additionalProperties": false
    },
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "ToolVersion": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Token"
        },
        "version": {
          "$ref": "#/$defs/Token"
        }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "ModelRef": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Token"
        },
        "id": {
          "$ref": "#/$defs/Token"
        }
      },
      "required": ["provider", "id"],
      "additionalProperties": false
    },
    "PromptTemplateRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Token"
        },
        "version": {
          "$ref": "#/$defs/Token"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": ["id", "version", "sha256"],
      "additionalProperties": false
    },
    "TerminologyServiceRef": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Token"
        },
        "version": {
          "$ref": "#/$defs/Token"
        },
        "snapshotSha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": ["name", "version", "snapshotSha256"],
      "additionalProperties": false
    },
    "SectionProvenance": {
      "type": "object",
      "properties": {
        "sourceKey": {
          "$ref": "#/$defs/SourceKey"
        },
        "spans": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceSpan"
          }
        },
        "narrativeDivSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "normalizedTextSha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": ["sourceKey", "spans", "narrativeDivSha256", "normalizedTextSha256"],
      "additionalProperties": false
    },
    "SourceSpan": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "startOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endOffset": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "textSha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": ["page", "startOffset", "endOffset", "textSha256"],
      "additionalProperties": false,
      "description": "Half-open code-point range [startOffset, endOffset) on a page and the SHA-256 of the raw slice's UTF-8 bytes."
    },
    "StructuringDecision": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/TargetPath"
        },
        "sourceKey": {
          "$ref": "#/$defs/SourceKey"
        },
        "sourceField": {
          "$ref": "#/$defs/SourcePath"
        },
        "action": {
          "$ref": "#/$defs/DecisionAction"
        },
        "ruleId": {
          "$ref": "#/$defs/Token"
        },
        "terminologyRef": {
          "$ref": "#/$defs/TerminologyRef"
        },
        "editorId": {
          "$ref": "#/$defs/Token"
        },
        "reason": {
          "$ref": "#/$defs/DecisionReason"
        }
      },
      "required": ["target", "action"],
      "additionalProperties": false
    },
    "TargetPath": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:\\[[0-9]+\\])?(?:\\.[A-Za-z][A-Za-z0-9]*(?:\\[[0-9]+\\])?)*$"
    },
    "SourcePath": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:List|Bundle|Composition)(?:\\.[A-Za-z][A-Za-z0-9]*(?:\\[(?:[0-9]{1,4}|[A-Za-z][A-Za-z0-9]*)\\])?)*$"
    },
    "DecisionAction": {
      "type": "string",
      "enum": ["extracted-verbatim", "code-mapped", "defaulted-by-rule", "human-edited", "rejected"]
    },
    "TerminologyRef": {
      "type": "object",
      "properties": {
        "system": {
          "$ref": "#/$defs/HttpUrl"
        },
        "code": {
          "$ref": "#/$defs/Token"
        },
        "version": {
          "$ref": "#/$defs/Token"
        },
        "lookupId": {
          "$ref": "#/$defs/Token"
        }
      },
      "required": ["system", "code", "lookupId"],
      "additionalProperties": false,
      "description": "Receipt of the terminology lookup that produced a code."
    },
    "DecisionReason": {
      "type": "string",
      "enum": [
        "boundary-correction",
        "code-correction",
        "metadata-correction",
        "not-applicable",
        "unreadable-source",
        "out-of-scope",
        "duplicate"
      ]
    },
    "FidelitySummary": {
      "type": "object",
      "properties": {
        "normalizationVersion": {
          "$ref": "#/$defs/NormalizationVersion"
        },
        "status": {
          "$ref": "#/$defs/FidelityStatus"
        },
        "sectionsChecked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sectionsMatched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "narrativeBindingSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "reportSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "reportUri": {
          "$ref": "#/$defs/StorageUri"
        }
      },
      "required": [
        "normalizationVersion",
        "status",
        "sectionsChecked",
        "sectionsMatched",
        "narrativeBindingSha256",
        "reportSha256"
      ],
      "additionalProperties": false
    },
    "NormalizationVersion": {
      "type": "string",
      "pattern": "^fidelity-norm\\/[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Version of docs/fidelity-normalization.md the hashes were computed under."
    },
    "FidelityStatus": {
      "type": "string",
      "enum": ["passed", "failed"]
    }
  }
}
