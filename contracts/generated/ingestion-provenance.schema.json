{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khs.dev/contracts/ingestion-provenance/1.0.0/schema.json",
  "$ref": "#/$defs/IngestionProvenance",
  "$defs": {
    "IngestionProvenance": {
      "type": "object",
      "properties": {
        "sourceDocument": {
          "$ref": "#/$defs/SourceDocument"
        },
        "extraction": {
          "$ref": "#/$defs/ExtractionTooling"
        },
        "sections": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/SectionProvenance"
          }
        },
        "decisions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/StructuringDecision"
          }
        },
        "fidelity": {
          "$ref": "#/$defs/FidelitySummary"
        }
      },
      "required": ["sourceDocument", "extraction", "sections", "decisions", "fidelity"],
      "additionalProperties": false
    },
    "SourceDocument": {
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "byteLength": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "mediaType": {
          "$ref": "#/$defs/MediaType"
        },
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,254}$"
        },
        "pageCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sourceSystem": {
          "$ref": "#/$defs/SourceSystemRef"
        },
        "storageUri": {
          "$ref": "#/$defs/StorageUri"
        },
        "extractedText": {
          "$ref": "#/$defs/ExtractedTextRef"
        }
      },
      "required": ["sha256", "byteLength", "mediaType", "filename", "extractedText"],
      "additionalProperties": false
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lower-case hexadecimal SHA-256 digest."
    },
    "MediaType": {
      "type": "string",
      "enum": [
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      ]
    },
    "SourceSystemRef": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "versionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": ["name", "documentId"],
      "additionalProperties": false,
      "description": "Identity of the document in its system of record."
    },
    "StorageUri": {
      "type": "string",
      "pattern": "^gs:\\/\\/[a-z0-9][a-z0-9._-]{1,220}[a-z0-9]\\/\\S+$",
      "description": "Cloud Storage object URI (gs://bucket/object)."
    },
    "ExtractedTextRef": {
      "type": "object",
      "properties": {
        "uri": {
          "$ref": "#/$defs/StorageUri"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": ["uri", "sha256", "extractorVersion"],
      "additionalProperties": false,
      "description": "Reference to the extractor's page text (a SourceDocumentText object). It contains narrative and is never inlined."
    },
    "ExtractionTooling": {
      "type": "object",
      "properties": {
        "extractionRunId": {
          "$ref": "#/$defs/Uuid"
        },
        "serviceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "parser": {
          "$ref": "#/$defs/ToolVersion"
        },
        "model": {
          "$ref": "#/$defs/ModelRef"
        },
        "promptTemplate": {
          "$ref": "#/$defs/PromptTemplateRef"
        },
        "terminologyService": {
          "$ref": "#/$defs/TerminologyServiceRef"
        }
      },
      "required": ["extractionRunId", "serviceVersion", "parser"],
      "additionalProperties": false
    },
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "ToolVersion": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "ModelRef": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": ["provider", "id"],
      "additionalProperties": false
    },
    "PromptTemplateRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": ["id", "version", "sha256"],
      "additionalProperties": false
    },
    "TerminologyServiceRef": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "snapshotSha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": ["name", "version", "snapshotSha256"],
      "additionalProperties": false
    },
    "SectionProvenance": {
      "type": "object",
      "properties": {
        "sourceKey": {
          "$ref": "#/$defs/SourceKey"
        },
        "spans": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceSpan"
          }
        },
        "narrativeDivSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "normalizedTextSha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": ["sourceKey", "spans", "narrativeDivSha256", "normalizedTextSha256"],
      "additionalProperties": false
    },
    "SourceKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9]+)*$",
      "description": "Canonical SmPC section identifier from the mapping manifest, e.g. smpc.4.2.posology."
    },
    "SourceSpan": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "startOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endOffset": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "textSha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": ["page", "startOffset", "endOffset", "textSha256"],
      "additionalProperties": false,
      "description": "Half-open code-point range [startOffset, endOffset) on a page and the SHA-256 of the raw slice's UTF-8 bytes."
    },
    "StructuringDecision": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sourceKey": {
          "$ref": "#/$defs/SourceKey"
        },
        "action": {
          "$ref": "#/$defs/DecisionAction"
        },
        "ruleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "terminologyRef": {
          "$ref": "#/$defs/TerminologyRef"
        },
        "editorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "reason": {
          "$ref": "#/$defs/DecisionReason"
        }
      },
      "required": ["target", "action"],
      "additionalProperties": false
    },
    "DecisionAction": {
      "type": "string",
      "enum": ["extracted-verbatim", "code-mapped", "defaulted-by-rule", "human-edited", "rejected"]
    },
    "TerminologyRef": {
      "type": "object",
      "properties": {
        "system": {
          "$ref": "#/$defs/HttpUrl"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "lookupId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": ["system", "code", "lookupId"],
      "additionalProperties": false,
      "description": "Receipt of the terminology lookup that produced a code."
    },
    "HttpUrl": {
      "type": "string",
      "format": "uri"
    },
    "DecisionReason": {
      "type": "string",
      "enum": [
        "boundary-correction",
        "code-correction",
        "metadata-correction",
        "not-applicable",
        "unreadable-source",
        "out-of-scope",
        "duplicate"
      ]
    },
    "FidelitySummary": {
      "type": "object",
      "properties": {
        "normalizationVersion": {
          "$ref": "#/$defs/NormalizationVersion"
        },
        "status": {
          "$ref": "#/$defs/FidelityStatus"
        },
        "sectionsChecked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sectionsMatched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "narrativeBindingSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "reportSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "reportUri": {
          "$ref": "#/$defs/StorageUri"
        }
      },
      "required": [
        "normalizationVersion",
        "status",
        "sectionsChecked",
        "sectionsMatched",
        "narrativeBindingSha256",
        "reportSha256"
      ],
      "additionalProperties": false
    },
    "NormalizationVersion": {
      "type": "string",
      "pattern": "^fidelity-norm\\/\\d+\\.\\d+\\.\\d+$",
      "description": "Version of docs/fidelity-normalization.md the hashes were computed under."
    },
    "FidelityStatus": {
      "type": "string",
      "enum": ["passed", "failed"]
    }
  }
}
