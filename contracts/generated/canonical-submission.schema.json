{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khs.dev/contracts/canonical-submission/1.0.0/schema.json",
  "$ref": "#/$defs/CanonicalSubmission",
  "$defs": {
    "CanonicalSubmission": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "submissionId": {
          "$ref": "#/$defs/Uuid"
        },
        "createdAt": {
          "$ref": "#/$defs/IsoDateTime"
        },
        "bundle": {
          "$ref": "#/$defs/Type2Bundle"
        },
        "bundleSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "provenance": {
          "$ref": "#/$defs/IngestionProvenance"
        },
        "approval": {
          "$ref": "#/$defs/Approval"
        }
      },
      "required": [
        "schemaVersion",
        "submissionId",
        "createdAt",
        "bundle",
        "bundleSha256",
        "provenance",
        "approval"
      ],
      "additionalProperties": false,
      "description": "Approved hand-off from Zone A structuring to Zone B publishing. Zone B recomputes every hash and re-executes the fidelity check before transforming anything."
    },
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "IsoDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with Z or a numeric offset."
    },
    "Type2Bundle": {
      "type": "object",
      "properties": {
        "resourceType": {
          "type": "string",
          "const": "Bundle"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "type": {
          "type": "string",
          "const": "document"
        },
        "identifier": {
          "type": "object",
          "properties": {
            "system": {
              "$ref": "#/$defs/CanonicalUri"
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            }
          },
          "additionalProperties": false
        },
        "timestamp": {
          "$ref": "#/$defs/IsoDateTime"
        },
        "entry": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fullUrl": {
                "$ref": "#/$defs/CanonicalUri"
              },
              "resource": {
                "type": "object",
                "properties": {
                  "resourceType": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "required": ["resourceType"],
                "additionalProperties": {}
              }
            },
            "required": ["fullUrl", "resource"],
            "additionalProperties": {}
          }
        }
      },
      "required": ["resourceType", "type", "identifier", "timestamp", "entry"],
      "additionalProperties": {},
      "description": "HL7 Global ePI Type 2 document Bundle (FHIR R5). Structural validation happens in Zone B preflight and the HL7 validator."
    },
    "CanonicalUri": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:https?:\\/\\/[A-Za-z0-9.-]{1,253}(?:[/?#][A-Za-z0-9._~:/?#@!$&'()*+,;=%|-]*)?|urn:[A-Za-z0-9._~:/?#@!$&'()*+,;=%|-]+)$"
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lower-case hexadecimal SHA-256 digest."
    },
    "IngestionProvenance": {
      "type": "object",
      "properties": {
        "sourceDocument": {
          "$ref": "#/$defs/SourceDocument"
        },
        "extraction": {
          "$ref": "#/$defs/ExtractionTooling"
        },
        "sections": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/SectionProvenance"
          }
        },
        "decisions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/StructuringDecision"
          }
        },
        "fidelity": {
          "$ref": "#/$defs/FidelitySummary"
        }
      },
      "required": ["sourceDocument", "extraction", "sections", "decisions", "fidelity"],
      "additionalProperties": false
    },
    "SourceDocument": {
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "byteLength": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "mediaType": {
          "$ref": "#/$defs/MediaType"
        },
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,254}$"
        },
        "pageCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sourceSystem": {
          "$ref": "#/$defs/SourceSystemRef"
        },
        "storageUri": {
          "$ref": "#/$defs/StorageUri"
        },
        "extractedText": {
          "$ref": "#/$defs/ExtractedTextRef"
        }
      },
      "required": ["sha256", "byteLength", "mediaType", "filename", "extractedText"],
      "additionalProperties": false
    },
    "MediaType": {
      "type": "string",
      "enum": [
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      ]
    },
    "SourceSystemRef": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Token"
        },
        "documentId": {
          "$ref": "#/$defs/Token"
        },
        "versionId": {
          "$ref": "#/$defs/Token"
        }
      },
      "required": ["name", "documentId"],
      "additionalProperties": false,
      "description": "Identity of the document in its system of record."
    },
    "Token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,127}$",
      "description": "Identifier: letters, digits, and . _ : / @ + - only."
    },
    "StorageUri": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^gs:\\/\\/[a-z0-9][a-z0-9._-]{1,220}[a-z0-9]\\/[A-Za-z0-9._/-]{1,256}$",
      "description": "Cloud Storage object URI (gs://bucket/object)."
    },
    "ExtractedTextRef": {
      "type": "object",
      "properties": {
        "uri": {
          "$ref": "#/$defs/StorageUri"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "extractorVersion": {
          "$ref": "#/$defs/Token"
        }
      },
      "required": ["uri", "sha256", "extractorVersion"],
      "additionalProperties": false,
      "description": "Reference to the extractor's page text (a SourceDocumentText object). It contains narrative and is never inlined."
    },
    "ExtractionTooling": {
      "type": "object",
      "properties": {
        "extractionRunId": {
          "$ref": "#/$defs/Uuid"
        },
        "serviceVersion": {
          "$ref": "#/$defs/Token"
        },
        "parser": {
          "$ref": "#/$defs/ToolVersion"
        },
        "model": {
          "$ref": "#/$defs/ModelRef"
        },
        "promptTemplate": {
          "$ref": "#/$defs/PromptTemplateRef"
        },
        "terminologyService": {
          "$ref": "#/$defs/TerminologyServiceRef"
        }
      },
      "required": ["extractionRunId", "serviceVersion", "parser"],
      "additionalProperties": false
    },
    "ToolVersion": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Token"
        },
        "version": {
          "$ref": "#/$defs/Token"
        }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "ModelRef": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Token"
        },
        "id": {
          "$ref": "#/$defs/Token"
        }
      },
      "required": ["provider", "id"],
      "additionalProperties": false
    },
    "PromptTemplateRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Token"
        },
        "version": {
          "$ref": "#/$defs/Token"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": ["id", "version", "sha256"],
      "additionalProperties": false
    },
    "TerminologyServiceRef": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Token"
        },
        "version": {
          "$ref": "#/$defs/Token"
        },
        "snapshotSha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": ["name", "version", "snapshotSha256"],
      "additionalProperties": false
    },
    "SectionProvenance": {
      "type": "object",
      "properties": {
        "sourceKey": {
          "$ref": "#/$defs/SourceKey"
        },
        "spans": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceSpan"
          }
        },
        "narrativeDivSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "normalizedTextSha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": ["sourceKey", "spans", "narrativeDivSha256", "normalizedTextSha256"],
      "additionalProperties": false
    },
    "SourceKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9]+)*$",
      "description": "Canonical SmPC section identifier from the mapping manifest, e.g. smpc.4.2.posology."
    },
    "SourceSpan": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "startOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endOffset": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "textSha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      },
      "required": ["page", "startOffset", "endOffset", "textSha256"],
      "additionalProperties": false,
      "description": "Half-open code-point range [startOffset, endOffset) on a page and the SHA-256 of the raw slice's UTF-8 bytes."
    },
    "StructuringDecision": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/TargetPath"
        },
        "sourceKey": {
          "$ref": "#/$defs/SourceKey"
        },
        "action": {
          "$ref": "#/$defs/DecisionAction"
        },
        "ruleId": {
          "$ref": "#/$defs/Token"
        },
        "terminologyRef": {
          "$ref": "#/$defs/TerminologyRef"
        },
        "editorId": {
          "$ref": "#/$defs/Token"
        },
        "reason": {
          "$ref": "#/$defs/DecisionReason"
        }
      },
      "required": ["target", "action"],
      "additionalProperties": false
    },
    "TargetPath": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:\\[\\d+\\])?(?:\\.[A-Za-z][A-Za-z0-9]*(?:\\[\\d+\\])?)*$"
    },
    "DecisionAction": {
      "type": "string",
      "enum": ["extracted-verbatim", "code-mapped", "defaulted-by-rule", "human-edited", "rejected"]
    },
    "TerminologyRef": {
      "type": "object",
      "properties": {
        "system": {
          "$ref": "#/$defs/HttpUrl"
        },
        "code": {
          "$ref": "#/$defs/Token"
        },
        "version": {
          "$ref": "#/$defs/Token"
        },
        "lookupId": {
          "$ref": "#/$defs/Token"
        }
      },
      "required": ["system", "code", "lookupId"],
      "additionalProperties": false,
      "description": "Receipt of the terminology lookup that produced a code."
    },
    "HttpUrl": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^https?:\\/\\/[A-Za-z0-9.-]{1,253}(?::\\d{1,5})?(?:[/?#][A-Za-z0-9._~:/?#@!$&'()*+,;=%|-]*)?$",
      "description": "http(s) URL without whitespace; may carry |version."
    },
    "DecisionReason": {
      "type": "string",
      "enum": [
        "boundary-correction",
        "code-correction",
        "metadata-correction",
        "not-applicable",
        "unreadable-source",
        "out-of-scope",
        "duplicate"
      ]
    },
    "FidelitySummary": {
      "type": "object",
      "properties": {
        "normalizationVersion": {
          "$ref": "#/$defs/NormalizationVersion"
        },
        "status": {
          "$ref": "#/$defs/FidelityStatus"
        },
        "sectionsChecked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sectionsMatched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "narrativeBindingSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "reportSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "reportUri": {
          "$ref": "#/$defs/StorageUri"
        }
      },
      "required": [
        "normalizationVersion",
        "status",
        "sectionsChecked",
        "sectionsMatched",
        "narrativeBindingSha256",
        "reportSha256"
      ],
      "additionalProperties": false
    },
    "NormalizationVersion": {
      "type": "string",
      "pattern": "^fidelity-norm\\/\\d+\\.\\d+\\.\\d+$",
      "description": "Version of docs/fidelity-normalization.md the hashes were computed under."
    },
    "FidelityStatus": {
      "type": "string",
      "enum": ["passed", "failed"]
    },
    "Approval": {
      "type": "object",
      "properties": {
        "approverId": {
          "$ref": "#/$defs/PrincipalId"
        },
        "approverRole": {
          "$ref": "#/$defs/ApproverRole"
        },
        "approvedAt": {
          "$ref": "#/$defs/IsoDateTime"
        },
        "method": {
          "$ref": "#/$defs/ApprovalMethod"
        },
        "meaning": {
          "$ref": "#/$defs/ApprovalMeaning"
        },
        "approvedContentSha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "recordRef": {
          "$ref": "#/$defs/RecordRef"
        }
      },
      "required": [
        "approverId",
        "approverRole",
        "approvedAt",
        "method",
        "meaning",
        "approvedContentSha256"
      ],
      "additionalProperties": false
    },
    "PrincipalId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "ApproverRole": {
      "type": "string",
      "enum": ["content-reviewer", "qa-reviewer"]
    },
    "ApprovalMethod": {
      "type": "string",
      "enum": ["api-attestation", "manual-record"],
      "description": "Attestation placeholders. Electronic signature is a future control boundary."
    },
    "ApprovalMeaning": {
      "type": "string",
      "enum": ["reviewed-fidelity-and-structure"]
    },
    "RecordRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#?=&%+-]{0,511}$"
    }
  }
}
