# Pinned by digest for reproducible validator images (eclipse-temurin:21-jre-jammy's multi-arch
# index as resolved on 2026-09-20). Move the digest deliberately, never by rebuilding a tag.
FROM eclipse-temurin:21-jre-jammy@sha256:61d6c7b34d36aee3f45d043101259f97f3c6d428dc2a6f75513789983c5e254f

ARG VALIDATOR_VERSION=6.10.4
ARG VALIDATOR_SHA256=1106b9d58f9e363e47bea7c4fc065841e5fc91fe9d062775c3bfdd212bd653cc
ARG GLOBAL_EPI_SHA256=6cdbc95ff054ef52c16e1beaec1c81c9e04fab1c0123b31de6ff1748e30ba0b1
ARG EMA_EPI_SHA256=19fb9fbf55c6bb3819c78d427acac1e3e5b96b50c1045d80e70c94f09566bd80
ARG TERMINOLOGY_SHA256=c2ee6bccc9d0130d0a90db5967e7adbf9dd175df7a3351c531642c3dce102d10
ARG EXTENSIONS_SHA256=f1039cac888d79ebd29878d7debe5e647ffe7ed962a9033da095258a03a06105

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/fhir
RUN curl -fL \
      "https://github.com/hapifhir/org.hl7.fhir.core/releases/download/${VALIDATOR_VERSION}/validator_cli.jar" \
      -o validator_cli.jar \
    && echo "${VALIDATOR_SHA256}  validator_cli.jar" | sha256sum --check - \
    && curl -fsSL \
      "https://hl7.org/fhir/uv/emedicinal-product-info/package.tgz" \
      -o global-epi-package.tgz \
    && echo "${GLOBAL_EPI_SHA256}  global-epi-package.tgz" | sha256sum --check - \
    && curl -fsSL \
      "https://epi.ema.europa.eu/fhirig/1.0.0/package.tgz" \
      -o ema-epi-package.tgz \
    && echo "${EMA_EPI_SHA256}  ema-epi-package.tgz" | sha256sum --check - \
    && curl -fsSL \
      "https://packages2.fhir.org/packages/hl7.terminology.r5/7.3.0" \
      -o terminology-package.tgz \
    && echo "${TERMINOLOGY_SHA256}  terminology-package.tgz" | sha256sum --check - \
    && curl -fsSL \
      "https://packages2.fhir.org/packages/hl7.fhir.uv.extensions.r5/5.3.0" \
      -o extensions-package.tgz \
    && echo "${EXTENSIONS_SHA256}  extensions-package.tgz" | sha256sum --check -

EXPOSE 8090
ENTRYPOINT ["java", "-Xms768m", "-Xmx1536m", "-jar", "/opt/fhir/validator_cli.jar"]
# -allowNetworkAccess: without it, FhirValidatorHttpService binds to the loopback
# address only (127.0.0.1) regardless of the port given here, which Cloud Run's
# sidecar networking/probes cannot reach -- the container never fails to start,
# its startup probe just never succeeds. This service isn't itself internet
# exposed: only the "worker" container publishes a port in infra/run.tf.
CMD ["server", "8090", "-allowNetworkAccess", "-version", "5.0.0", "-ig", "/opt/fhir/terminology-package.tgz", "-ig", "/opt/fhir/extensions-package.tgz", "-ig", "/opt/fhir/global-epi-package.tgz", "-ig", "/opt/fhir/ema-epi-package.tgz", "-tx", "n/a"]
