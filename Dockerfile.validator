# Pinned by digest for reproducible validator images (eclipse-temurin:21-jre-noble's multi-arch
# index as resolved on 2026-09-22). Move the digest deliberately, never by rebuilding a tag.
# Ubuntu 24.04 since 2026-09-22, from 22.04 (21-jre-jammy@sha256:61d6c7b3…): the same Temurin
# build (JAVA_VERSION=jdk-21.0.12+8) and the same LANG/LC_ALL in both images, so only the
# operating system under the JRE moved. The Cloud Build step validator-starts-offline and the
# deploy's smoke run are what prove the image; the CI official-validation job runs the same jar
# on setup-java's Temurin 21, not in this image. CI's Images job builds this file and starts it
# offline on every pull request that changes it.
#
# Two stages (audit B07, S-5). `fetch` downloads and verifies the validator and every package;
# the runtime stage copies what it verified and nothing else, drops the download tools the base
# ships, and runs as a user without root. Neither stage installs anything from a package archive:
# the base already carries curl and the CA certificates, so no build depends on what an Ubuntu
# mirror serves that day (until B07 it ran apt-get update against the live archive).
FROM eclipse-temurin:21-jre-noble@sha256:7739f0ffce786528961eea6bf46d9610ee968ac6127c9b2e93494757bdecce9f AS fetch

# The validator and the five -ig packages: four downloaded, and the repository's own
# (dev.khs.fhir.epi, the definitions of the systems and extension the pipeline writes) copied from
# the build context, where it is committed as scripts/fhir/generate-artifacts.ts builds it, byte
# for byte reproducibly. Each package's id#version and SHA-256 are also in
# fhir/standards.lock.json, which the worker's run manifest reads; the FHIR store's profile import
# takes the four downloaded ones from it, not the repository's own. test/ci/validator-pins.test.ts
# holds the two equal. The Global ePI package is HL7's versioned STU1 URL, not the unversioned
# "current" one, which moves when HL7 publishes the next release (audit B07, S-3;
# docs/validation/changes).
ARG VALIDATOR_VERSION=6.10.4
ARG VALIDATOR_SHA256=1106b9d58f9e363e47bea7c4fc065841e5fc91fe9d062775c3bfdd212bd653cc
ARG GLOBAL_EPI_SHA256=c997673388d2c53bd7dad43777a7589443e4d27f56a661a90aa0638bbce1cf3a
ARG EMA_EPI_SHA256=19fb9fbf55c6bb3819c78d427acac1e3e5b96b50c1045d80e70c94f09566bd80
ARG TERMINOLOGY_SHA256=c2ee6bccc9d0130d0a90db5967e7adbf9dd175df7a3351c531642c3dce102d10
ARG EXTENSIONS_SHA256=f1039cac888d79ebd29878d7debe5e647ffe7ed962a9033da095258a03a06105
ARG KHS_EPI_SHA256=4e597ba97dfeb4170e649b99affba63337e7980f3c7f9f6c804b5ac45828999a

WORKDIR /opt/fhir
RUN curl -fL \
      "https://github.com/hapifhir/org.hl7.fhir.core/releases/download/${VALIDATOR_VERSION}/validator_cli.jar" \
      -o validator_cli.jar \
    && echo "${VALIDATOR_SHA256}  validator_cli.jar" | sha256sum --check - \
    && curl -fsSL \
      "https://hl7.org/fhir/uv/emedicinal-product-info/STU1/package.tgz" \
      -o global-epi-package.tgz \
    && echo "${GLOBAL_EPI_SHA256}  global-epi-package.tgz" | sha256sum --check - \
    && curl -fsSL \
      "https://epi.ema.europa.eu/fhirig/1.0.0/package.tgz" \
      -o ema-epi-package.tgz \
    && echo "${EMA_EPI_SHA256}  ema-epi-package.tgz" | sha256sum --check - \
    && curl -fsSL \
      "https://packages2.fhir.org/packages/hl7.terminology.r5/7.3.0" \
      -o terminology-package.tgz \
    && echo "${TERMINOLOGY_SHA256}  terminology-package.tgz" | sha256sum --check - \
    && curl -fsSL \
      "https://packages2.fhir.org/packages/hl7.fhir.uv.extensions.r5/5.3.0" \
      -o extensions-package.tgz \
    && echo "${EXTENSIONS_SHA256}  extensions-package.tgz" | sha256sum --check -
COPY fhir/generated/dev.khs.fhir.epi.tgz /opt/fhir/khs-epi-package.tgz
RUN echo "${KHS_EPI_SHA256}  khs-epi-package.tgz" | sha256sum --check -

# The packages the validator resolves on its own beyond the five -ig files, pinned by checksum in
# fhir/validator-packages.lock and installed into the package cache at build time. Without this
# the sidecar downloaded all nine from the FHIR registry on every cold start, validated against
# whatever the registry served that day, and could not start without it. Each tarball is verified
# before it is unpacked; a mismatch fails the build. This is not a startup-speed change: the
# worker was ready in 57 seconds before and after; the time is loading and indexing.
COPY fhir/validator-packages.lock /opt/fhir/validator-packages.lock
# Statements are separated by `;`, not chained with `&&`, and every step that can fail exits
# explicitly. POSIX `set -e` is ignored for any command inside an AND-OR list other than the
# last, so a loop chained with `&&` would carry on past a checksum mismatch and ship the package.
RUN set -eu; \
    cache=/opt/fhir/home/.fhir/packages; \
    mkdir -p "$cache"; \
    printf '[cache]\nversion = 4\n' > "$cache/packages.ini"; \
    grep -Ev '^[[:space:]]*(#|$)' /opt/fhir/validator-packages.lock > /tmp/packages.txt; \
    while read -r id version sha256; do \
      curl -fsSL "https://packages2.fhir.org/packages/${id}/${version}" -o /tmp/package.tgz || exit 1; \
      echo "${sha256}  /tmp/package.tgz" | sha256sum --check - || exit 1; \
      mkdir -p "$cache/${id}#${version}" || exit 1; \
      tar -xzf /tmp/package.tgz -C "$cache/${id}#${version}" || exit 1; \
      rm /tmp/package.tgz; \
    done < /tmp/packages.txt; \
    installed="$(ls -d "$cache"/*#* | wc -l)"; \
    listed="$(wc -l < /tmp/packages.txt)"; \
    [ "$installed" -eq "$listed" ] || { echo "installed $installed packages, listed $listed" >&2; exit 1; }; \
    rm /tmp/packages.txt

# The runtime: the verified files, owned by the user the validator runs as (it writes lock and
# index files into its package cache on start), and no curl or wget, which the base image ships
# and the validator never needs. Purging needs no package archive.
FROM eclipse-temurin:21-jre-noble@sha256:7739f0ffce786528961eea6bf46d9610ee968ac6127c9b2e93494757bdecce9f

RUN set -eu; \
    apt-get purge --yes --auto-remove curl wget; \
    for tool in curl wget; do \
      if command -v "$tool" >/dev/null; then echo "$tool is still in the runtime image" >&2; exit 1; fi; \
    done; \
    useradd --system --uid 10001 --user-group --home-dir /opt/fhir/home --no-create-home --shell /usr/sbin/nologin validator
COPY --from=fetch --chown=validator:validator /opt/fhir /opt/fhir
WORKDIR /opt/fhir
USER validator

EXPOSE 8090
# -Duser.home points the validator at the package cache installed above. The proxy settings give
# it no route out: any attempt to fetch a package, a profile or anything else fails loudly at a
# closed local port instead of reaching the internet, so an unlisted dependency is a startup
# failure, never a silent download. Inbound requests from the worker are unaffected.
ENTRYPOINT ["java", "-Xms768m", "-Xmx1536m", "-Duser.home=/opt/fhir/home", "-Djava.net.useSystemProxies=false", "-Dhttp.proxyHost=127.0.0.1", "-Dhttp.proxyPort=9", "-Dhttps.proxyHost=127.0.0.1", "-Dhttps.proxyPort=9", "-jar", "/opt/fhir/validator_cli.jar"]
# -allowNetworkAccess: without it, FhirValidatorHttpService binds to the loopback
# address only (127.0.0.1) regardless of the port given here, which Cloud Run's
# sidecar networking/probes cannot reach -- the container never fails to start,
# its startup probe just never succeeds. This service isn't itself internet
# exposed: only the "worker" container publishes a port in infra/run.tf.
# -jurisdiction uv and -locale en-US: without them the validator takes both from the container's
# locale, which on 2026-09-21 meant EMA content was validated under United States jurisdiction.
# -no-http-access: the validator's own switch that refuses every HTTP(S) request inside the
# application ("Access to the internet is not allowed by local security policy"). The closed
# proxy above stays as a second layer for any client that bypasses it. Beyond reproducibility this
# closes a request-forgery path: the validator's documentation warns that content being
# validated can direct it to fetch URLs of the content's choosing, including internal addresses
# such as Cloud Run's metadata server, and this sidecar validates content that arrives in
# submissions.
CMD ["server", "8090", "-allowNetworkAccess", "-version", "5.0.0", "-jurisdiction", "uv", "-locale", "en-US", "-ig", "/opt/fhir/terminology-package.tgz", "-ig", "/opt/fhir/extensions-package.tgz", "-ig", "/opt/fhir/global-epi-package.tgz", "-ig", "/opt/fhir/ema-epi-package.tgz", "-ig", "/opt/fhir/khs-epi-package.tgz", "-tx", "n/a", "-no-http-access"]
