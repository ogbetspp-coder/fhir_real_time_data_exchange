# The dev environment's own inputs to scripts/gcp/deploy.sh, and the only place they are set.
# deploy.sh sources the file named after EMA_FLOW_ENVIRONMENT, so the pull-request plan
# (.github/workflows/plan.yml) and the deploy (.github/workflows/deploy.yml) read the same values
# and the plan is what applies. Until 2026-09-27 each workflow set them itself, the plan omitted
# one, and every plan showed a change to the query service that no pull request had made.
#
# NAME=value lines only (test/ci/environment-inputs.test.ts). A value here overrides the caller's
# environment, and an input this file leaves out takes its default, never the caller's value.

# The one project dev is deployed to. deploy.sh refuses any other, so a dev deploy (and dev's
# relaxed inputs below) cannot land in another project by a mistyped variable (audit B08, L1).
EXPECTED_PROJECT_ID=sage-ship-509104-b8

# The query service logs the category of an authentication refusal (never the token).
QUERY_LOG_REJECTION_REASON=true

# The worker accepts synthetic content (the demo) beside the EMA's public labels, and keeps the
# fixture and healthcare-api sources (docs/design/authority-import-contract.md, D7).
ALLOW_SYNTHETIC_SOURCES=true

# Alerts may page no one (owner decision, 2026-09-28: early development, no real address yet).
# The alert policies are still created and show in the console, but notify nobody. No channel is
# made for a stand-in address: Google would mail a verification to it, and it would look real in
# the console. The deploy and plan workflows do not pass ALERT_NOTIFICATION_EMAIL or
# ALERT_NOTIFICATION_CHANNELS to dev, so a value left in either repository variable is ignored.
# Only dev may set this (deploy.sh and infra/variables.tf refuse it elsewhere). Before production
# or any real data, a real, monitored address is required.
REQUIRE_ALERT_RECIPIENT=false
