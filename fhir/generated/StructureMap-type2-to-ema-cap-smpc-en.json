{
  "resourceType": "StructureMap",
  "id": "type2-to-ema-cap-smpc-en",
  "url": "https://khs.dev/fhir/StructureMap/type2-to-ema-cap-smpc-en",
  "version": "1.4.0",
  "name": "Type2ToEmaCapSmpcEnglish",
  "title": "HL7 Global ePI Type 2 to EMA CAP SmPC English",
  "status": "active",
  "experimental": true,
  "description": "The crosswalk of src/fhir/transform.ts in the FHIR mapping language, its executed differential twin: test/official/structuremap-twin.test.ts runs both on every fixture and fails on any difference. The map transforms; it does not mint ids or rewrite references (FML has no SHA-256 and no generic walk), and the refusals stay in TypeScript and validation. Where FML allows, it fails closed: a check refuses a source that is not a document, a first entry that is not a Composition, a section without exactly one canonical code, a code the map does not carry, a section without a canonical code that has narrative or subsections, and narrative without a div. docs/design/structuremap-twin.md says what it cannot express.",
  "structure": [
    {
      "url": "http://hl7.org/fhir/StructureDefinition/Bundle",
      "mode": "source",
      "alias": "Type2Bundle"
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/Bundle",
      "mode": "target",
      "alias": "EmaBundle"
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/Composition",
      "mode": "source",
      "alias": "SourceComposition"
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/Composition",
      "mode": "target",
      "alias": "EmaComposition"
    }
  ],
  "group": [
    {
      "name": "Type2BundleToEmaBundle",
      "documentation": "The document Bundle. FML has no SHA-256, so the map leaves to the implementation the ids it\r\nmints. The target identifier's system is ema-document, and its value, also the Bundle's id, is\r\nderived from the source Bundle.identifier.value (src/lib/hash.ts stableUuid, namespace \"ema-bundle\"):\r\ntake the SHA-256 of the UTF-8 string \"ema-bundle:\" followed by the value, in lowercase hex;\r\nkeep its first 32 hex digits;\r\nset the 13th digit to 5 and the 17th digit to a;\r\nand write the 32 digits as a UUID, in groups of 8-4-4-4-12 joined by hyphens.\r\nEvery entry's fullUrl and id and each section's id are minted alike, and every\r\nReference.reference is rewritten to the new fullUrls. The Composition's identifier names one\r\nversion (docs/design/version-identity.md): its value is minted alike from the source\r\nBundle.identifier.value and the SHA-256 of the Composition without its identifier.",
      "input": [
        {
          "name": "src",
          "type": "Type2Bundle",
          "mode": "source"
        },
        {
          "name": "tgt",
          "type": "EmaBundle",
          "mode": "target"
        }
      ],
      "rule": [
        {
          "name": "document",
          "source": [
            {
              "context": "src",
              "check": "type = 'document'"
            }
          ],
          "target": [
            {
              "context": "tgt",
              "element": "type",
              "transform": "copy",
              "parameter": [
                {
                  "valueString": "document"
                }
              ]
            }
          ]
        },
        {
