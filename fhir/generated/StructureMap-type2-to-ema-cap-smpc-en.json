    {
      "name": "Section",
      "documentation": "A section: its canonical key translated through the published ConceptMap, its heading, its\r\nnarrative copied as it is, its subsections mapped in their order. A section without a canonical\r\ncode is dropped when it is an empty container and refused otherwise.",
      "input": [
        {
          "name": "src",
          "mode": "source"
        },
        {
          "name": "tgt",
          "mode": "target"
        }
      ],
      "rule": [
        {
          "name": "sectionCode",
          "source": [
            {
              "context": "src",
              "element": "code",
              "variable": "code",
              "check": "coding.where(system = 'https://khs.dev/fhir/CodeSystem/canonical-smpc-sections').count() = 1"
            }
          ],
          "rule": [
            {
              "name": "canonicalCode",
              "source": [
                {
                  "context": "code",
                  "element": "coding",
                  "variable": "coding",
                  "condition": "system = 'https://khs.dev/fhir/CodeSystem/canonical-smpc-sections'",
                  "check": "('smpc' | 'smpc.1' | 'smpc.2' | 'smpc.2.1' | 'smpc.2.2' | 'smpc.2.excipients' | 'smpc.3' | 'smpc.4' | 'smpc.4.1' | 'smpc.4.2' | 'smpc.4.2.posology' | 'smpc.4.2.posology.paediatric' | 'smpc.4.2.administration' | 'smpc.4.2.administration.precautions' | 'smpc.4.3' | 'smpc.4.4' | 'smpc.4.4.traceability' | 'smpc.4.4.paediatric' | 'smpc.4.5' | 'smpc.4.5.paediatric' | 'smpc.4.6' | 'smpc.4.6.pregnancy' | 'smpc.4.6.breast-feeding' | 'smpc.4.6.fertility' | 'smpc.4.7' | 'smpc.4.8' | 'smpc.4.8.paediatric' | 'smpc.4.8.reporting' | 'smpc.4.9' | 'smpc.4.9.paediatric' | 'smpc.5' | 'smpc.5.1' | 'smpc.5.1.mechanism' | 'smpc.5.1.effects' | 'smpc.5.1.efficacy' | 'smpc.5.1.paediatric' | 'smpc.5.2' | 'smpc.5.2.absorption' | 'smpc.5.2.distribution' | 'smpc.5.2.biotransformation' | 'smpc.5.2.elimination' | 'smpc.5.2.linearity' | 'smpc.5.2.pk-pd' | 'smpc.5.3' | 'smpc.5.3.era' | 'smpc.6' | 'smpc.6.1' | 'smpc.6.2' | 'smpc.6.3' | 'smpc.6.4' | 'smpc.6.5' | 'smpc.6.6' | 'smpc.6.6.paediatric' | 'smpc.7' | 'smpc.8' | 'smpc.9' | 'smpc.10' | 'smpc.11' | 'smpc.12') contains code"
                }
              ],
              "rule": [
                {
                  "name": "code",
                  "source": [
                    {
                      "context": "coding"
                    }
                  ],
                  "target": [
                    {
                      "variable": "emaCode",
                      "transform": "translate",
                      "parameter": [
                        {
                          "valueId": "coding"
                        },
                        {
                          "valueString": "https://khs.dev/fhir/ConceptMap/canonical-to-ema-cap-smpc-en"
                        },
                        {
                          "valueString": "code"
                        }
                      ]
                    },
                    {
                      "context": "tgt",
                      "element": "code",
                      "variable": "targetCode"
                    },
                    {
                      "context": "targetCode",
                      "element": "coding",
                      "variable": "emaCoding",
                      "transform": "c",
                      "parameter": [
                        {
                          "valueString": "http://ema.europa.eu/fhir/ValueSet/EUepismpcqrdcodesVs"
                        },
                        {
                          "valueId": "emaCode"
                        }
                      ]
                    }
                  ],
                  "rule": [
                    {
                      "name": "heading",
                      "source": [
                        {
                          "context": "coding",
                          "condition": "((code = 'smpc.6.5') or (code = 'smpc.6.6')).not()"
                        }
                      ],
                      "target": [
                        {
                          "context": "tgt",
                          "element": "title",
                          "transform": "evaluate",
                          "parameter": [
                            {
                              "valueString": "%emaCoding.display"
                            }
                          ]
                        }
                      ],
                      "documentation": "The heading is the EMA display, but for 6.5 and 6.6, whose displays bracket their\r\noptional wording: their heading is the source's when it is the template's shorter form,\r\nand the full form otherwise."
                    },
                    {
                      "name": "shortHeading65",
                      "source": [
                        {
                          "context": "src",
                          "element": "title",
                          "variable": "title",
                          "condition": "(%coding.code = 'smpc.6.5') and ($this = '6.5 Nature and contents of container')"
                        }
                      ],
                      "target": [
                        {
                          "context": "tgt",
                          "element": "title",
                          "transform": "copy",
                          "parameter": [
                            {
                              "valueId": "title"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "name": "heading65",
                      "source": [
                        {
                          "context": "src",
                          "condition": "(%coding.code = 'smpc.6.5') and title.where($this = '6.5 Nature and contents of container').empty()"
                        }
                      ],
                      "target": [
                        {
                          "context": "tgt",
                          "element": "title",
                          "transform": "copy",
                          "parameter": [
                            {
                              "valueString": "6.5 Nature and contents of container and special equipment for use, administration or implantation"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "name": "shortHeading66",
                      "source": [
                        {
                          "context": "src",
                          "element": "title",
                          "variable": "title",
                          "condition": "(%coding.code = 'smpc.6.6') and ($this = '6.6 Special precautions for disposal')"
                        }
                      ],
                      "target": [
                        {
                          "context": "tgt",
                          "element": "title",
                          "transform": "copy",
                          "parameter": [
                            {
                              "valueId": "title"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "name": "heading66",
                      "source": [
                        {
                          "context": "src",
                          "condition": "(%coding.code = 'smpc.6.6') and title.where($this = '6.6 Special precautions for disposal').empty()"
                        }
                      ],
                      "target": [
                        {
                          "context": "tgt",
                          "element": "title",
                          "transform": "copy",
                          "parameter": [
                            {
                              "valueString": "6.6 Special precautions for disposal and other handling"
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "documentation": "The EMA code through the published ConceptMap, and its display from the EMA's own value\r\nset of SmPC section codes (EUePI package). translate() throws on a noMap key."
                }
              ]
            }
          ]
        },
        {
          "name": "sectionHasCode",
          "source": [
            {
              "context": "src",
              "check": "code.exists()"
            }
          ]
        },
        {
          "name": "narrative",
          "source": [
            {
              "context": "src",
              "element": "text",
              "variable": "text",
              "check": "div.exists()"
            }
          ],
          "target": [
            {
              "context": "tgt",
              "element": "text",
              "transform": "copy",
              "parameter": [
                {
                  "valueId": "text"
                }
              ]
            }
          ]
        },
        {
          "name": "subsections",
          "source": [
            {
              "context": "src",
              "element": "section",
              "variable": "section",
              "condition": "code.coding.where(system = 'https://khs.dev/fhir/CodeSystem/canonical-smpc-sections').exists()"
            }
          ],
          "target": [
            {
              "context": "tgt",
              "element": "section",
              "variable": "targetSection"
            }
          ],
          "dependent": [
            {
              "name": "Section",
              "parameter": [
                {
                  "valueId": "section"
                },
                {
                  "valueId": "targetSection"
                }
              ]
            }
          ]
        },
        {
          "name": "emptySubsection",
          "source": [
            {
              "context": "src",
              "element": "section",
              "variable": "section",
              "condition": "code.coding.where(system = 'https://khs.dev/fhir/CodeSystem/canonical-smpc-sections').empty()",
              "check": "text.empty() and section.empty()"
            }
          ]
        }
      ]
    }
  ]
}
