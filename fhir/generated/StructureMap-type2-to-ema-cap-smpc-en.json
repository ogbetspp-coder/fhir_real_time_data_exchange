                {
                  "context": "src"
                }
              ],
              "target": [
                {
                  "context": "meta",
                  "element": "profile",
                  "transform": "copy",
                  "parameter": [
                    {
                      "valueString": "http://ema.europa.eu/fhir/StructureDefinition/EUEpiBundle"
                    }
                  ]
                }
              ]
            }
