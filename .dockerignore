.git
.gitignore
node_modules
dist
coverage
.terraform
*.tfstate*
fhir/vendor
infra
docs
test
.cache
.claude
agent
# Zone A and the label reader: only what the worker's recompute installs (Dockerfile, the python
# stage) reaches the build.
zone-a/*
!zone-a/pyproject.toml
!zone-a/uv.lock
!zone-a/README.md
!zone-a/src
label-docx-reader/*
!label-docx-reader/pyproject.toml
!label-docx-reader/README.md
!label-docx-reader/src
**/__pycache__
