1999/xhtml\"><p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">AstraZeneca BV</p>\n<p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">Prinses Beatrixlaan 582</p>\n<p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\"><span style=\"font-size: 11.0pt; font-family: 'Times New Roman', serif;\">2595 BM Den Haag</span></p>\n<p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">&#160;</p></div>"},"code":{"coding":[{"system":"https://spor.ema.europa.eu/v1/lists/200000029659/terms/","code":"200000029873","display":"11. NAAM EN ADRES VAN DE HOUDER VAN DE VERGUNNING VOOR HET IN DE HANDEL BRENGEN"}]}},{"id":"8d34f591-1f47-ee11-be6d-000d3aa92960","title":"12. NUMMER(S) VAN DE VERGUNNING VOOR HET IN DE HANDEL BRENGEN","text":{"status":"generated","div":"<div xmlns=\"http://www.w3.org/1999/xhtml\"><p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">RVG 12277</p>\n<p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">&#160;</p></div>"},"code":{"coding":[{"system":"https://spor.ema.europa.eu/v1/lists/200000029659/terms/","code":"200000029874","display":"12. NUMMER(S) VAN DE VERGUNNING VOOR HET IN DE HANDEL BRENGEN"}]}},{"id":"8e34f591-1f47-ee11-be6d-000d3aa92960","title":"13. PARTIJNUMMER","text":{"status":"generated","div":"<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>&#160;</p>\n<p>&#160;</p></div>"},"code":{"coding":[{"system":"https://spor.ema.europa.eu/v1/lists/200000029659/terms/","code":"200000029875","display":"13. PARTIJNUMMER"}]}},{"id":"9034f591-1f47-ee11-be6d-000d3aa92960","title":"14. ALGEMENE INDELING VOOR DE AFLEVERING","text":{"status":"generated","div":"<div xmlns=\"http://www.w3.org/1999/xhtml\"><p><span style=\"font-size: 11.0pt; font-family: 'Times New Roman', serif;\">U.R.</span></p>\n<p>&#160;</p></div>"},"code":{"coding":[{"system":"https://spor.ema.europa.eu/v1/lists/200000029659/terms/","code":"200000029876","display":"14. ALGEMENE INDELING VOOR DE AFLEVERING"}]}},{"id":"8f34f591-1f47-ee11-be6d-000d3aa92960","title":"15. INSTRUCTIES VOOR GEBRUIK","text":{"status":"generated","div":"<div xmlns=\"http://www.w3.org/1999/xhtml\"><p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">Toedienen volgens voorschrift arts (zie ommezijde voor gebruiksaanwijzing).</p>\n<p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">&#160;</p>\n<p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\"><em>[op ommezijde:]</em></p>\n<ol style=\"margin-bottom: 0in; margin-top: 0px;\">\n<li style=\"margin: 0in 0in 0in 0px; font-size: 11pt; font-family: 'Times New Roman', serif; text-indent: 14.2px; text-align: justify;\">Laat de pati&#235;nt in een comfortabele positie plaatsnemen met het bovenlichaam iets omhoog. Bepaal een injectieplaats op de buik onder de navel.&#160; &#160; &#160; &#160; Reinig de injectieplaats.</li>\n<li style=\"margin: 0in 0in 0in 0px; font-size: 11pt; font-family: 'Times New Roman', serif; text-indent: 14.2px;\">Neem de injectiespuit uit het geopende foliezakje en houd de injectiespuit schuin tegen het licht om te controleren of het Zoladex-depot zichtbaar&#160; &#160; &#160; &#160; is in het venster (figuur 1).</li>\n<li style=\"margin: 0in 0in 0in 0px; font-size: 11pt; font-family: 'Times New Roman', serif; text-indent: 14.2px;\">Trek de plastic veiligheidsclip van de injectiespuit en gooi de clip weg (figuur 2). Verwijder de naaldbeschermer. <strong>Het is niet nodig om&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; luchtbellen te verwijderen. Probeer dit niet, want hierdoor kan het implantatiestaafje uit positie raken.</strong></li>\n<li style=\"margin: 0in 0in 0in 0px; font-size: 11pt; font-family: 'Times New Roman', serif; text-indent: 14.2px;\">Houd de injectiespuit vast bij de beschermhuls. Pak de buikhuid losjes samen in een plooi. Houd de opening van de naald naar boven gericht.&#160; &#160; &#160; &#160; &#160; &#160; &#160; Breng de naald subcutaan in onder een hoek van 30 to 45 graden totdat de beschermhuls de huid van de pati&#235;nt raakt (figuur 3).</li>\n<li style=\"margin: 0in 0in 0in 0px; font-size: 11pt; font-family: 'Times New Roman', serif; text-indent: 14.2px;\">Let op: niet injecteren in spierweefsel of door het buikvlies. Foutieve positie en toedieningshoek worden getoond in figuur 4.</li>\n<li style=\"margin: 0in 0in 0in 0px; font-size: 11pt; font-family: 'Times New Roman', serif; text-indent: 14.2px;\">Verplaats de vingers naar de vingergreep. Injecteer het Zoladex-depot door de zuiger volledig naar beneden te drukken. Hierbij kan men een &#8220;klik&#8221;&#160; &#160; &#160; horen en zal de beschermhuls over de naald glijden. Indien de zuiger <strong>niet</strong> volledig is ingedrukt zal de beschermhuls <strong>niet</strong> geactiveerd worden.</li>\n<li style=\"margin: 0in 0in 0in 0px; font-size: 11pt; font-family: 'Times New Roman', serif; text-indent: 14.2px;\">Trek de naald terug en laat de beschermhuls verder over de naald glijden (figuur 5).<br />&#160; &#160; Dek de injectieplaats steriel af. Gooi de injectiespuit in een daarvoor bestemde naaldcontainer.</li>\n</ol>\n<p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">&#160;</p></div>"},"code":{"coding":[{"system":"https://spor.ema.europa.eu/v1/lists/200000029659/terms/","code":"200000029877","display":"15. INSTRUCTIES VOOR GEBRUIK"}]}},{"id":"9134f591-1f47-ee11-be6d-000d3aa92960","title":"16. INFORMATIE IN BRAILLE","text":{"status":"generated","div":"<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>&#160;</p>\n<p>&#160;</p></div>"},"code":{"coding":[{"system":"https://spor.ema.europa.eu/v1/lists/200000029659/terms/","code":"200000029878","display":"16. INFORMATIE IN BRAILLE"}]}}],"code":{"coding":[{"system":"https://spor.ema.europa.eu/v1/lists/200000029659/terms/","code":"200000029862","display":"GEGEVENS DIE OP DE VERPAKKING MOETEN WORDEN VERMELD: INSTRUCTIEKAART"}]}},{"id":"5ee8b6e5-3447-ee11-be6d-000d3aaa0ed0","title":"GEGEVENS DIE IN IEDER GEVAL OP BLISTERVERPAKKINGEN OF STRIPS MOETEN WORDEN VERMELD - FOLIE EN SPUIT","text":{"status":"generated","div":"<div xmlns=\"http://www.w3.org/1999/xhtml\">&#160;</div>"},"section":[{"id":"74e8b6e5-3447-ee11-be6d-000d3aaa0ed0","title":"1. NAAM VAN HET GENEESMIDDEL","text":{"status":"generated","div":"<div xmlns=\"http://www.w3.org/1999/xhtml\"><p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">Zoladex 3.6&#160;mg</p>\n<p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">&#160;</p>\n<p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">goserelin</p>\n<p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">&#160;</p></div>"},"code":{"coding":[{"system":"https://spor.ema.europa.eu/v1/lists/200000029659/terms/","code":"200000029863","display":"1. NAAM VAN HET GENEESMIDDEL"}]}},{"id":"7d83bdeb-3447-ee11-be6d-000d3aaa0ed0","title":"2. NAAM VAN DE HOUDER VAN DE VERGUNNING VOOR HET IN DE HANDEL BRENGEN","text":{"status":"generated","div":"<div xmlns=\"http://www.w3.org/1999/xhtml\"><p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">AstraZeneca</p>\n<p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">&#160;</p></div>"},"code":{"coding":[{"system":"https://spor.ema.europa.eu/v1/lists/200000029659/terms/","code":"200000029864","display":"2. NAAM VAN DE HOUDER VAN DE VERGUNNING VOOR HET IN DE HANDEL BRENGEN"}]}},{"id":"7c83bdeb-3447-ee11-be6d-000d3aaa0ed0","title":"3. UITERSTE GEBRUIKSDATUM","text":{"status":"generated","div":"<div xmlns=\"http://www.w3.org/1999/xhtml\"><p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">EXP</p>\n<p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">&#160;</p></div>"},"code":{"coding":[{"system":"https://spor.ema.europa.eu/v1/lists/200000029659/terms/","code":"200000029865","display":"3. UITERSTE GEBRUIKSDATUM"}]}},{"id":"7a83bdeb-3447-ee11-be6d-000d3aaa0ed0","title":"4. PARTIJNUMMER","text":{"status":"generated","div":"<div xmlns=\"http://www.w3.org/1999/xhtml\"><p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">Lot</p>\n<p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">&#160;</p></div>"},"code":{"coding":[{"system":"https://spor.ema.europa.eu/v1/lists/200000029659/terms/","code":"200000029866","display":"4. PARTIJNUMMER"}]}},{"id":"7e83bdeb-3447-ee11-be6d-000d3aaa0ed0","title":"5. OVERIGE","text":{"status":"generated","div":"<div xmlns=\"http://www.w3.org/1999/xhtml\"><p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\"><em><span style=\"font-size: 11.0pt; font-family: 'Times New Roman', serif;\">alleen op het folie: [instructieplaatjes voor openen folie]</span></em></p>\n<p style=\"margin: 0in; font-size: 11pt; font-family: 'Times New Roman', serif;\">&#160;</p></div>"},"code":{"coding":[{"system":"https://spor.ema.europa.eu/v1/lists/200000029659/terms/","code":"200000029867","display":"5. OVERIGE"}]}}],"code":{"coding":[{"system":"https://spor.ema.europa.eu/v1/lists/200000029659/terms/","code":"200000029862","display":"GEGEVENS DIE IN IEDER GEVAL OP BLISTERVERPAKKINGEN OF STRIPS MOETEN WORDEN VERMELD - FOLIE EN SPUIT"}]}}],"code":{"coding":[{"system":"https://spor.ema.europa.eu/v1/lists/200000029659/terms/","code":"200000029861","display":"ETIKETTERING"}]}}]}}]}