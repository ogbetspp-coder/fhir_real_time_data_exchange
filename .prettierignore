# Credential files that google-github-actions/auth writes into the workspace; never formatted,
# never read by tooling.
gha-creds-*.json

# Generated, vendored, and build output
node_modules/
dist/
coverage/
fhir/vendor/
.terraform/
package-lock.json

# Zone A (Python). The two virtualenvs and the tool caches are local build output; nothing under
# them is committed, and walking them would only slow the gate down. `.uv-bootstrap` holds `uv`
# itself, which cannot live in `.venv` because `uv sync --frozen` prunes it.
zone-a/.venv/
zone-a/.uv-bootstrap/
zone-a/.mypy_cache/
zone-a/.pytest_cache/
zone-a/.ruff_cache/

# The differential corpora: JSONL, generated, and not formatted by anything.
zone-a/tests/fixtures/differential-smoke.jsonl
# What Chrome drew for the Word fixtures, written by zone-a/scripts/word_fixtures.py as canonical
# JSON and replayed by digest.
zone-a/tests/fixtures/word-smpc/chrome.json
differential.jsonl

# The agent (Python). Same shape as Zone A: two virtualenvs and the tool caches are local
# build output. The vendored contracts and code-point table are written by
# scripts/sync_contract.py; formatting them would make the --check comparison fail.
agent/.venv/
agent/.uv-bootstrap/
agent/.mypy_cache/
agent/.pytest_cache/
agent/.ruff_cache/
agent/src/verifiable_answer_agent/contracts/query-tools.schema.json
agent/src/verifiable_answer_agent/contracts/agent-turn.schema.json
agent/src/verifiable_answer_agent/contracts/code-points.json

# The label reader (Python), with its own gate (.github/workflows/label-docx-reader.yml) and its
# own formatter; its JSON corpus and locks are compared byte for byte.
label-docx-reader/

# Agent worktrees that Claude Code creates under the repository; each is its own checkout and
# is never part of this tree's gate or its commits.
.claude/worktrees/

# Byte copies of the EMA's published ePI, pinned by hash in labels/ema-epi/sources.lock.json;
# reformatting them would change the bytes the lock records.
labels/ema-epi/sources/
labels/ema-epi/lists/
src/authority/data/underline-letters.json
test/fixtures/authority/underline-cases.json
test/fixtures/authority/vectors.json
# Written by Zone A's scripts and compared byte for byte with what they write
# (zone-a/scripts/check_labels.py, zone-a/scripts/generate_style_cases.py).
labels/ema-epi/checks/
test/fixtures/authority/style-cases.json
